{
  "name": "lumix",
  "version": "0.4.0",
  "description": "Stream dramas, series and movies",
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "test:util": "vitest run --project util",
    "test:source": "vitest run --project source",
    "test": "vitest run",
    "dev": "tsc && node --trace-warnings --env-file=.env dist/server.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@stremio-addon/sdk": "^1.1.0",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "fuse.js": "^7.5.0",
    "fuzzball": "^2.2.6",
    "hono": "^4.13.21",
    "hono-rate-limiter": "^0.5.4",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
