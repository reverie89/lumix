{
  "name": "lumix",
  "version": "0.2.0",
  "description": "Stream dramas, series and movies",
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "test:util": "vitest run --project util",
    "test:source": "vitest run --project source",
    "test": "vitest run",
    "dev": "tsc && node --trace-warnings --env-file=.env dist/server.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@stremio-addon/sdk": "^1.1.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "fuse.js": "^7.5.0",
    "fuzzball": "^2.2.6",
    "hono": "^4.13.8",
    "hono-rate-limiter": "^0.5.4",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
